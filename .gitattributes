* text=auto

# Build, source and documentation files must be byte-identical across Windows
# and Linux so local formatters exercise the same input as GitHub Actions.
*.go text eol=lf
*.sh text eol=lf
*.gradle text eol=lf
*.kts text eol=lf
*.kt text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.svelte text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
Dockerfile text eol=lf
Makefile text eol=lf
gradlew text eol=lf
.env.example text eol=lf
.gitignore text eol=lf
.dockerignore text eol=lf
.gitattributes text eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf

# Encrypted and media assets are never text-normalized.
*.enc binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.ttf binary
*.woff2 binary
*.apk binary
*.aab binary
*.zip binary
