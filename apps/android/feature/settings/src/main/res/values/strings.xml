    <string name="settings_download_wifi">Download on Wi-Fi only</string>
    <string name="settings_download_wifi_note">Disable to allow episode downloads over metered mobile data.</string>
    <string name="settings_palette_title">Color palette</string>
    <string name="settings_palette_note">Nine palettes, the same nine the web app has. Each one has a light and a dark version.</string>
    <string name="settings_palette_eucalyptus">Eucalyptus</string>
