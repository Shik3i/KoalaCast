    <string name="settings_appearance_title">Appearance</string>
    <string name="settings_theme_system">System</string>
    <string name="settings_theme_light">Light</string>
    <string name="settings_theme_dark">Dark</string>
    <string name="settings_theme_note">Dark is the design\'s home ground — an accent colour only reaches full contrast on a dark surface.</string>

    <string name="settings_languages_title">Spoken languages</string>
    <string name="settings_languages_note">Filters Discover and Search by the language a show is actually in, not by store region. Pick none to see everything.</string>

    <string name="settings_category_title">Default category</string>
    <string name="settings_category_note">Pre-selected when you open Search. You can always widen it from there.</string>

    <string name="settings_privacy_title">Privacy</string>
    <string name="settings_proxy_images">Load cover art through your server</string>
    <string name="settings_proxy_images_note">Keeps publisher CDNs and Apple from seeing this device\'s address. Turn it off to fetch artwork directly.</string>
    <string name="settings_audio_never_proxied">Episode audio always streams straight from the publisher — it never passes through a KoalaCast server.</string>
    <string name="settings_privacy_policy">Read privacy policy</string>
