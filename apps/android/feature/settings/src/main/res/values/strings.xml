    <string name="settings_title">Settings</string>

    <string name="settings_server_title">KoalaCast server</string>
    <string name="settings_server_placeholder">cast.example.org</string>
    <string name="settings_server_note">Switching servers changes what an account means: subscriptions, queue and progress are stored per server, and a sign-in on one instance does not carry to another.</string>
    <string name="settings_server_cleartext">This address uses plain HTTP. Fine on your own network, unsafe over the internet.</string>
