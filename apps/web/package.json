{
  "name": "koalacast-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "generate:seo": "node scripts/generate-seo.mjs",
    "prebuild": "npm run generate:seo",
    "build": "svelte-kit sync && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "check:i18n": "node scripts/check-translations.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.0.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.5.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/node": "^20.19.43",
    "svelte": "^5.0.0",
    "svelte-check": "^4.7.3",
    "typescript": "^5.3.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@phosphor-icons/web": "^2.1.2",
    "dompurify": "^3.4.12",
    "idb": "^8.0.0"
  },
  "overrides": {
    "cookie": "0.7.2"
  }
}
