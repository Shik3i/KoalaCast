{
  "name": "koalacast-web",
  "version": "0.11.8",
  "private": true,
  "packageManager": "npm@11.16.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev",
    "generate:icons": "node scripts/generate-icon-subset.mjs",
    "generate:seo": "node scripts/generate-seo.mjs",
    "prebuild": "npm run generate:seo",
    "build": "svelte-kit sync && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "check:docs": "node scripts/check-docs.mjs",
    "check:i18n": "node scripts/check-translations.mjs",
    "check:release-policy": "node scripts/check-release-policy.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "test": "vitest run",
    "test:ui": "playwright test",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@emnapi/core": "2.0.0-alpha.5",
    "@emnapi/runtime": "2.0.0-alpha.5",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.6.5",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@phosphor-icons/web": "^2.1.2",
    "dompurify": "^3.4.14",
    "idb": "^8.0.0"
  }
}
