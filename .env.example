# KoalaCast Server Configuration Example

# Server Environment
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000/api/v1
LOG_LEVEL=info # debug, info, warn, error
SESSION_SECRET=change-this-to-a-secure-random-32-byte-secret-in-production

# Database Settings
DATABASE_PATH=./data/koalacast.db

# Security & Registration
# KC_REGISTRATION_ENABLED environment variable acts as a strict override if set.
# If unset, administrator setting in DB determines registration availability.
KC_REGISTRATION_ENABLED=true
PEPPER_SECRET= # Optional HMAC-SHA256 secret key for Argon2id password hashing
TRUSTED_PROXIES=127.0.0.1,::1
SECURE_COOKIES=false # Set to true in production HTTPS environments
# Optional: relay podcast audio when a publisher blocks browser-side Web Audio
# effects or offline downloads. Disabled by default because relay traffic uses
# server bandwidth.
KC_AUDIO_EFFECTS_PROXY_ENABLED=false

# Podcast Index API Credentials (Optional)
# If left empty, direct RSS URL feed additions remain fully functional, but catalog search UI will notify users that search is unavailable.
PODCAST_INDEX_KEY=
PODCAST_INDEX_SECRET=

# Admin account seeding (Optional). On startup the API creates this account with
# the admin role, or promotes it if it already exists. The password is only used
# to CREATE the account and is never overwritten on later boots. A one-time
# recovery code is printed to the API logs when the account is first created.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Background Feed Worker
FEED_WORKER_CONCURRENCY=5
FEED_REQUEST_TIMEOUT_MS=15000
FEED_MAX_RESPONSE_BYTES=10485760 # 10 MB limit for RSS XML
FEED_MAX_STORED_EPISODES=200

# Web Push (required for notifications while the browser is closed).
# Generate once with: cd services/api && go run ./cmd/vapid
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=https://your-koalacast.example

# CORS Settings (Only required for third-party/native clients outside same-origin deployment)
ALLOWED_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
