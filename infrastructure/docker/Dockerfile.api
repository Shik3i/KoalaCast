FROM golang:1.22-alpine AS builder

RUN apk add --no-cache gcc musl-dev

WORKDIR /app

COPY services/api/go.mod services/api/go.sum* ./
RUN go mod download

COPY services/api/ ./
RUN CGO_ENABLED=1 GOOS=linux go build -ldflags="-w -s" -o koalacast-api ./cmd/server

FROM alpine:3.19

RUN apk add --no-cache ca-certificates sqlite-libs tzdata

WORKDIR /app
RUN addgroup -S koala && adduser -S koala -G koala

COPY --from=builder /app/koalacast-api /app/koalacast-api
RUN mkdir -p /app/data && chown -R koala:koala /app

USER koala

EXPOSE 8080
ENV PORT=8080
ENV DATABASE_PATH=/app/data/koalacast.db

CMD ["/app/koalacast-api"]
